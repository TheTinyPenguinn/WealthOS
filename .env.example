SUPABASE_URL=           # Your Supabase project URL
SUPABASE_ANON_KEY=      # Public anon key (safe for client)
SUPABASE_SERVICE_ROLE_KEY=  # SERVER SIDE ONLY — never commit
ANTHROPIC_API_KEY=      # Anthropic API key
OPENAI_API_KEY=         # OpenAI API key
GEMINI_API_KEY=         # Google AI Studio key
LLM_PROVIDER=gemini  # gemini | openai | anthropic (install matching SDK: pip install google-generativeai | openai | anthropic)
